.docker/
*.pid
*.pid.lock

# VB6 transient/project-local files (do NOT ignore .frm/.frx)
*.vbp.local
*.vbw
*.exp
*.lib
*.obj
*.ilk
*.pdb
*.aps

# OS files
.DS_Store
Thumbs.db
