################################################################################
# Repository-wide ignores
################################################################################

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/
*.sln.iml

# .NET build outputs
[Bb]in/
[Oo]bj/
out/
TestResults/
