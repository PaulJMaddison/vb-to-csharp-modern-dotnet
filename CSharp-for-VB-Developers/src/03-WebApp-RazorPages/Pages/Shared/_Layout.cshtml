<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebAppRazorPages</title>
    <style>
        body { font-family: system-ui, Arial; margin: 2rem; }
        .card { padding: 1rem; border: 1px solid #ddd; border-radius: 12px; max-width: 820px; }
        code { background: #f5f5f5; padding: 0.1rem 0.3rem; border-radius: 6px; }
    </style>
</head>
<body>
    <main role="main" class="card">
        @RenderBody()
    </main>
</body>
</html>
