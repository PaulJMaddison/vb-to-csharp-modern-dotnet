{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "webApiCleanRoute": {
        "ClusterId": "webApiCleanCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "webApiWithAuthRoute": {
        "ClusterId": "webApiWithAuthCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "webApiCleanCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5111/"
          }
        }
      },
      "webApiWithAuthCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5222/"
          }
        }
      }
    }
  }
}
